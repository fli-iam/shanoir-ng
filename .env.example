# Template for the Shanoir configuration. Copy it to '.env' (not tracked by git) and fill in
# the secrets, which are empty here and have no default:
#   cp .env.example .env
# Never commit '.env'.
#
# The values here are the production ones. For a development machine, bootstrap.sh creates
# '.env' from this file with the development values: SHANOIR_MIGRATION=dev,
# SHANOIR_CERTIFICATE=auto and SHANOIR_KEYCLOAK_API=full.

# Url where shanoir is reachable (SHANOIR_URL_SCHEME://SHANOIR_URL_HOST)
#
# In the default setup, SHANOIR_URL_HOST is 'shanoir-ng-nginx' which is the
# default name of the nginx container.
#
# Possible schemes are 'https' (default) and 'http' (not recommended)
SHANOIR_URL_SCHEME=https
SHANOIR_URL_HOST=shanoir-ng-nginx

# URL where the OHIF-Viewer is reachable (SHANOIR_VIEWER_OHIF_URL_SCHEME://SHANOIR_VIEWER_OHIF_URL_HOST)
SHANOIR_VIEWER_OHIF_URL_SCHEME=https
SHANOIR_VIEWER_OHIF_URL_HOST=viewer

# URL where the VIDEPE viewer (EEG + imaging) is reachable (SHANOIR_VIEWER_VIDEPE_URL_SCHEME://SHANOIR_VIEWER_VIDEPE_URL_HOST)
SHANOIR_VIEWER_VIDEPE_URL_SCHEME=https
SHANOIR_VIEWER_VIDEPE_URL_HOST=videpe

# Maximum number of parallel requests the OHIF-Viewer issues for image interaction (loading).
SHANOIR_VIEWER_OHIF_INTERACTION_NUM_REQUESTS=100
# Maximum number of parallel requests the OHIF-Viewer issues for thumbnail loading.
SHANOIR_VIEWER_OHIF_THUMBNAIL_NUM_REQUESTS=75
# Maximum number of parallel requests the OHIF-Viewer issues for prefetching.
SHANOIR_VIEWER_OHIF_PREFETCH_NUM_REQUESTS=25

# SMTP infos used by shanoir for all outgoing mail
SHANOIR_SMTP_HOST=mailpit
SHANOIR_SMTP_PORT=1025
SHANOIR_SMTP_AUTH=false
SHANOIR_SMTP_USERNAME=none
SHANOIR_SMTP_PASSWORD=none
SHANOIR_SMTP_STARTTLS_ENABLE=false
SHANOIR_SMTP_STARTTLS_REQUIRED=false
SHANOIR_SMTP_FROM=do-not-reply@inria.fr

# Name and email address for sending emails
SHANOIR_NOTIFICATION_EMAIL=notification@inria.fr
SHANOIR_NOTIFICATION_NAME=local admin

# Name and email address for sending emails
SHANOIR_ADMIN_EMAIL=notification@inria.fr
SHANOIR_ADMIN_NAME=local admin

# Main contact address for this shanoir instance
SHANOIR_CONTACT_EMAIL=developers_shanoir@inria.fr

# Contact address for data protection requests
SHANOIR_DPO_EMAIL=dpo@inria.fr

# SHANOIR_PREFIX: Prefix prepended on all container names.
#
# If you need to deploy multiple instances of shanoir on the same docker host,
# then you may use a different value for each deployment.
#   eg: SHANOIR_PREFIX=prod-
#       SHANOIR_PREFIX=qualif-
SHANOIR_PREFIX=

# Shanoir images pulled by docker-compose.yml: <SHANOIR_REGISTRY>/<service>:<SHANOIR_IMAGE_TAG>
# (docker-compose-dev.yml builds them locally and ignores both).
#
# SHANOIR_REGISTRY: registry and path of the images. Change it to deploy from a mirror,
# e.g. on a network that cannot reach ghcr.io:
#   eg: SHANOIR_REGISTRY=registry.example.org/shanoir-ng
#
# SHANOIR_IMAGE_TAG: release to deploy.
#   'latest' is the highest NG_vX.Y.Z release.
#   To stay on a release, set its tag instead:
#   eg: SHANOIR_IMAGE_TAG=NG_vX.Y.Z (see https://github.com/fli-iam/shanoir-ng/releases)
#   Only releases newer than NG_v2.20.0 work with this file: the database images of older ones
#   ignore the accounts of this file (database) or fail to start (keycloak-database).
#   The running release: docker inspect --format \
#     '{{index .Config.Labels "org.opencontainers.image.version"}}' <container>
SHANOIR_REGISTRY=ghcr.io/fli-iam/shanoir-ng
SHANOIR_IMAGE_TAG=latest

# SHANOIR_ALLOWED_ADMIN_IPS: comma-separated list of IP addresses or networks
# from which admin accounts are allowed to log in.
#
#   eg: SHANOIR_ALLOWED_ADMIN_IPS=192.0.2.1,2001:db8:1::/64
#
# If empty then admin accounts allowed to log in from anywhere.
SHANOIR_ALLOWED_ADMIN_IPS=

# SHANOIR_X_FORWARDED: Generation of X-Forwarded-* HTTP headers
#
# Possible values:
#   'generate'	generate the X-Forwarded in the nginx container (default)
#   'trust'	trust the X-Forwarded-* headers in incoming requests. Use this
#		value if shanoir is located behind a reverse-proxy (NOTE: you
#		must ensure that the reverse-proxy properly sets the
#		'X-Forwarded-For' and 'X-Forwarded-Proto' headers).
#
SHANOIR_X_FORWARDED=generate


# SHANOIR_CERTIFICATE: Generation of the TLS server certificate
#
# Possible values:
#   'auto'	auto-generate a self-signed certificate
#		(development only, browsers and clients will not trust it)
#   'manual'	(default) use a manually generated certificate (provided by the
#		sysadmin, see SHANOIR_CERTIFICATE_PEM_CRT below)
SHANOIR_CERTIFICATE=manual

# SHANOIR_CERTIFICATE_PEM_CRT: server certificate file (PEM format)
# SHANOIR_CERTIFICATE_PEM_KEY: server key file         (PEM format)
#
# Theses files shall be made available in the "/opt/ssl" external volume of the
# nginx container.
#
# Set these variables to 'none' to disable TLS completely. The nginx container
# will then serve HTTP in plain text on port 80 (not recommended unless
# shanoir is located behind a reverse-proxy that provides the TLS endpoint)
#
SHANOIR_CERTIFICATE_PEM_CRT=shanoir-ng-nginx.crt
SHANOIR_CERTIFICATE_PEM_KEY=shanoir-ng-nginx.key


# Admin account (master realm) created on the keycloak server, and used by the
# 'users' container for managing users.
# SHANOIR_KEYCLOAK_PASSWORD is required. Generate one for a new install, e.g. with
#   openssl rand -base64 24
# Keycloak only reads it when it creates the admin account: on an existing install, put the
# password the admin account already has.
SHANOIR_KEYCLOAK_USER=admin
SHANOIR_KEYCLOAK_PASSWORD=

# Accounts of the Shanoir database (MariaDB): its root account and the account of each
# microservice. The passwords are required, one different password per account. Generate them for
# a new install, e.g. with
#   openssl rand -hex 32
# MariaDB only reads them when it creates the database volume: on an existing install, set them
# here, then apply them with ./rotate-passwords.sh (see README, "CHANGE THE PASSWORDS OF AN
# EXISTING INSTALL"). Do not rename an account of an existing install: the database would still
# have the old one.
SHANOIR_DB_ROOT_PASSWORD=
SHANOIR_USERS_DB_USER=users
SHANOIR_USERS_DB_PASSWORD=
SHANOIR_STUDIES_DB_USER=studies
SHANOIR_STUDIES_DB_PASSWORD=
SHANOIR_DATASETS_DB_USER=datasets
SHANOIR_DATASETS_DB_PASSWORD=
SHANOIR_IMPORT_DB_USER=import
SHANOIR_IMPORT_DB_PASSWORD=
SHANOIR_PRECLINICAL_DB_USER=preclinical
SHANOIR_PRECLINICAL_DB_PASSWORD=
SHANOIR_MIGRATIONS_DB_USER=migrations
SHANOIR_MIGRATIONS_DB_PASSWORD=

# Accounts of the Keycloak database (MariaDB): its root account and the account of Keycloak.
# Required. Same rules as the Shanoir database accounts above.
SHANOIR_KEYCLOAK_DB_ROOT_PASSWORD=
SHANOIR_KEYCLOAK_DB_USER=keycloak
SHANOIR_KEYCLOAK_DB_PASSWORD=

# RabbitMQ account used by the microservices (replaces the default guest/guest). The password is
# required, alphanumeric only (it is put in a URL). Generate one for a new install, e.g. with
#   openssl rand -hex 32
# RabbitMQ only creates this account when it initialises its volume (rabbitmq-data). To change
# the password of an existing install, change it in RabbitMQ too, then restart the microservices:
#   docker compose exec rabbitmq rabbitmqctl change_password <SHANOIR_RABBITMQ_USER> <new password>
# (installs created before this volume was fixed have an empty one: the account is created from
# here at their next start.)
SHANOIR_RABBITMQ_USER=shanoir
SHANOIR_RABBITMQ_PASSWORD=

# Keycloak URL (SHANOIR_KEYCLOAK_URL)
#
# If unset, the default is "${SHANOIR_URL_SCHEME}://${SHANOIR_URL_HOST}/auth"
# in order to use keycloak server embedded in this deployment.
#
# NOTE: using an external keycloak server is experimental.
#
#SHANOIR_KEYCLOAK_URL=https://shanoir-ng-nginx/auth

# URL where keycloak is reachable from the containers (SHANOIR_KEYCLOAK_INTERNAL_URL)
#
# If unset, the default is the same as SHANOIR_KEYCLOAK_URL
#
SHANOIR_KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth

# Authentification mode for the javascript keycloak adapter
#
# Possible values:
#   'check-sso'      (default) performs the authentication in a hidden iframe,
#                    which is fast but may not work with modern browsers when
#                    keycloak is served from a different hostname
#   'login-required' redirects to keycloak, which is slow but reliable
#
# see: https://www.keycloak.org/docs/latest/securing_apps/#_modern_browsers
SHANOIR_KEYCLOAK_ADAPTER_MODE=check-sso

# Keycloak API exposure (SHANOIR_KEYCLOAK_API)
#
# This variable controls which parts of the keycloak API are served by the
# nginx container.
#
# Possible values:
#   'limited'	(default) only expose the API endpoints needed to use the
#               'shanoir-ng' realm
#   'full'	expose the full keycloak API
#               (including the master realm & admin console; development only)
#
# To use the admin console (e.g. to create the first admin account), set 'full'
# for that time, apply it with 'docker compose up -d nginx', then set 'limited'
# back the same way.
#
SHANOIR_KEYCLOAK_API=limited

# SHANOIR_MIGRATION: Migration management (for spring/wildfly-based containers)
#
# 'auto' (default) applies the pending migrations at each start, so an upgrade
# with deploy.sh only needs the new images. To apply them by hand instead, run
# with 'never' and, after each upgrade, apply them once with:
#   docker compose run --rm -e SHANOIR_MIGRATION=manual database-migrations
#
# The 'keycloak' service does not implement any migration ('auto' and 'manual'
# are not supported). The upgrade procedure consists of:
#  1. exporting the user base into json files ('export')
#  2. redeploying the service from scratch ('init')
#  3. importing the json user files ('import')
#
# With 'init', 'manual', 'import' or 'export', the service stops as soon as the
# startup is complete (one shot run).
#
#
# Possible values:
#
#   'init'	initialise the data in the external volumes. Use it the first
#		time you deploy shanoir (see the bootstrap script)
#		CAUTION: existing data will be overwritten
#
#   'never'	do not apply any migration
#
#   'auto'	apply the migrations on startup, then run normally
#		(note: on migration failure, the database container will
#		 immediately exit to avoid running with an unexpected db schema)
#
#   'manual'	apply the migrations then exit
#
#   'dev'       development mode: let the microservices update the db schema
#               automatically (hibernate.ddl-auto=update). Never in production.
#
#   [keycloak container only]
#   'export'	export the user database into json files
#   'import'	import the user database from json files
#		CAUTION: existing data will be overwritten
#
SHANOIR_MIGRATION=auto

# Name of this shanoir instance
#
# If defined, the name is displayed in the UI at the top of the side-bar and
# prefixes the subject of every email sent by this instance. If left empty, the
# emails are prefixed with [Shanoir].
#
#   eg: SHANOIR_INSTANCE_NAME=QUALIF
#
SHANOIR_INSTANCE_NAME=

# Custom color for this shanoir instance
#
# If defined, this variable overrides the background color of the instance name
# and the color of the user icon in the side bar.
#
# This must be a valid HTML color (predefined name or #RGB value)
#
#   eg: SHANOIR_INSTANCE_COLOR=teal
#
SHANOIR_INSTANCE_COLOR=

# "file-system" or "s3"
SHANOIR_STORAGE_TYPE=file-system

# Number of concurrent requests to the pacs when downloading a dataset.
# This variable can be adjusted to improve the throughput, according to latency of the pacs.
SHANOIR_PACS_CONCURRENT_DOWNLOADS=16

# PACS (dcm4chee) Postgres database: name, user and password, and the maximum number of
# connections of dcm4chee-arc to it.
# Postgres only reads the name and user when it creates the database: don't change them on an
# existing install.
# The password is required. Generate one, e.g. with
#   openssl rand -hex 32
# On an existing install, apply it with ./rotate-passwords.sh after setting it (see README,
# "CHANGE THE PASSWORDS OF AN EXISTING INSTALL"). Until then, the password is 'pacs'.
SHANOIR_PACS_DATABASE_NAME=pacsdb
SHANOIR_PACS_DATABASE_USER=pacs
SHANOIR_PACS_DATABASE_PASSWORD=
SHANOIR_PACS_DATABASE_MAX_POOL_SIZE=150

# Passwords of the PACS LDAP server (dcm4chee configuration): its root account
# (cn=admin,dc=dcm4che,dc=org, also used by dcm4chee-arc) and its configuration account
# (cn=admin,cn=config). Required, alphanumeric only (the dcm4chee scripts don't quote them).
# Generate them, e.g. with
#   openssl rand -hex 32
# Only read when the LDAP volume is initialised: on an existing install, apply them with
# ./rotate-passwords.sh after setting them (see README, "CHANGE THE PASSWORDS OF AN EXISTING
# INSTALL"). Until then, both are the image default 'secret'.
SHANOIR_PACS_LDAP_ROOT_PASSWORD=
SHANOIR_PACS_LDAP_CONFIG_PASSWORD=

# PACS storage. Only read when the LDAP volume is initialised: on an existing install, change
# the storage in the dcm4chee configuration instead.
# Filesystem storage is the default. To use S3, set both:
#   SHANOIR_PACS_STORAGE_DIR=s3://my-bucket
#   SHANOIR_PACS_LDAP_STORAGE_URI=s3://my-bucket
SHANOIR_PACS_STORAGE_DIR=/storage/fs1
# LDAP entry of the storage (empty: the stock fs1 storage entry)
SHANOIR_PACS_LDAP_STORAGE_ENTRY_DN=dcmStorageID=fs1,dicomDeviceName=dcm4chee-arc,cn=Devices,cn=DICOM Configuration,dc=dcm4che,dc=org
SHANOIR_PACS_LDAP_STORAGE_URI=
# dcmProperty values to add to an LDAP entry (empty: the storage entry), separated by ';'.
# S3 example:
#   SHANOIR_PACS_LDAP_DCM_PROPERTIES=pathFormat={now,date,yyyy/MM/dd}/{0020000D,hash}/{0020000E,hash}/{00080018,hash}2;checkMountFile=NO_MOUNT1
SHANOIR_PACS_LDAP_PROPERTY_TARGET_DN=
SHANOIR_PACS_LDAP_DCM_PROPERTIES=

# Maximum number of examinations listed in the mail sent to study members when
# datasets are copied into their study (the others are summarized as "... and N more").
SHANOIR_MAIL_COPIED_EXAMINATIONS_MAX=50

# S3 configuration
S3_ENDPOINT=http://ninja:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# You can use only one bucket for all 3 microservices,
# a prefix is used internally to separate the actual data as well
S3_BUCKET_STUDIES=studies
S3_BUCKET_DATASETS=datasets
S3_BUCKET_PRECLINICAL=preclinical

# URL where VIP (Virtual Imaging Platform) is reachable (VIP_URL_SCHEME://VIP_URL_HOST)
# Used by the CARMIN-API-CLIENT in the front of shanoir-ng to query for pipelines
VIP_URL_SCHEME=https
VIP_URL_HOST=vip.ext.eskn.fr
# Secret of the Keycloak client 'service-account', used by the datasets service. Required.
# Alphanumeric only. Generate one for a new install, e.g. with
#   openssl rand -hex 32
# Only read when the realm is (re)imported: on an existing install, put the secret the client
# already has in the Keycloak admin console (realm shanoir-ng, client 'service-account').
VIP_CLIENT_SECRET=
VIP_SERVICE_EMAIL=''

# Maximum concurrent download requests being served to VIP
VIP_MAX_DOWNLOAD=4
VIP_COMPRESSION_LEVEL=1

# Secret of the Keycloak client 'neurobagel-export', used by the Neurobagel node export job.
# Alphanumeric only. Leave empty to keep the client unusable (Keycloak then gets a random secret).
# Only read when the realm is (re)imported: on an existing realm, set it in the Keycloak admin console.
NEUROBAGEL_CLIENT_SECRET=

#Shanoir shutdown and continuance hours
SHANOIR_SHUTDOWN_HOUR=2
SHANOIR_CONTINUANCE_HOUR=5

# Development only (docker-compose-dev.yml, SHANOIR_MIGRATION=dev): password given to the users
# that the users service recreates in Keycloak. Leave empty to give them random passwords.
# Never set it on a server reachable by other people.
DEV_USERS_DEFAULT_PASSWORD=

# SHANOIR_MAIL_SUPPLIER_BLACK_LIST: comma-separated list of mail domains refused on the account request form (subdomains are refused too).
# If empty then all mail suppliers are accepted.
SHANOIR_MAIL_SUPPLIER_BLACK_LIST=gmail.com,outlook.com,hotmail.com,live.com,yahoo.com,qq.com,163.com,126.com,icloud.com,mail.ru,gmx.com,gmx.net,web.de,zoho.com,protonmail.com,aol.com,naver.com,rediffmail.com,yandex.com,orange.fr,free.fr,laposte.net,libero.it,virgilio.it,seznam.cz,onet.pl,wp.pl,interia.pl,tutanota.com,fastmail.com
