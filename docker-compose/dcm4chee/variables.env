HTTP_PORT=8081
STORAGE_DIR=/storage/fs1
# Optional first-start LDAP override for storage entry.
# Target entry (default points to the stock fs1 storage entry).
LDAP_STORAGE_ENTRY_DN=dcmStorageID=fs1,dicomDeviceName=dcm4chee-arc,cn=Devices,cn=DICOM Configuration,dc=dcm4che,dc=org
# Filesystem storage is the default. To enable S3 on first LDAP init, set both:
#   STORAGE_DIR=s3://my-bucket
#   LDAP_STORAGE_URI=s3://my-bucket
# If unset/empty, ldap-first-start.sh keeps the stock filesystem configuration.
LDAP_STORAGE_URI=
# Optional first-start dcmProperty additions (one-shot).
# Target DN for dcmProperty updates (defaults to LDAP_STORAGE_ENTRY_DN).
LDAP_PROPERTY_TARGET_DN=
# One variable per property (env_file friendly).
# You can set as many as needed: LDAP_DCM_PROPERTY_1..LDAP_DCM_PROPERTY_N.
# S3 examples (uncomment when LDAP_STORAGE_URI points to S3):
# LDAP_DCM_PROPERTY_1=pathFormat={now,date,yyyy/MM/dd}/{0020000D,hash}/{0020000E,hash}/{00080018,hash}2
# LDAP_DCM_PROPERTY_2=checkMountFile=NO_MOUNT1
POSTGRES_DB=pacsdb
POSTGRES_USER=pacs
POSTGRES_PASSWORD=pacs
# --- Concurrency towards the archive -------------------------------------------------
# Sized so dcm4chee can actually serve the ~1000 simultaneous WADO retrieves the datasets
# service is now allowed to open (dcm4chee-arc.wado.pool.max-connections in
# shanoir-ng-datasets/src/main/resources/application.yml). Keep the three in step:
#   datasets pool.max-connections  <=  WILDFLY_IO_TASK_MAX_THREADS
#   WILDFLY_PACSDS_MAX_POOL_SIZE   <=  POSTGRES_MAX_CONNECTIONS (minus a few for admin)
#
# PacsDS JDBC pool: each retrieve does a short metadata lookup before streaming the object,
# so this does not need to match the request count 1:1, but it must not be the choke point.
WILDFLY_PACSDS_MAX_POOL_SIZE=400
# Undertow IO threads are the netty-style event loops: ~2x cores is plenty, more does not help.
WILDFLY_IO_THREADS=32
# Undertow worker (task) threads do the actual blocking retrieve work - this is the one that
# has to cover the concurrent request count. A retrieve blocks its worker while reading storage
# and writing the socket, so budget roughly one thread per concurrent request.
# Memory cost: each thread costs its stack (~1MB by default), so 1200 threads is ~1.2GB of stack
# on top of the heap. Give the dcm4chee container enough RAM, and consider adding -Xss256k plus
# an explicit -Xmx via JAVA_OPTS if you push this higher.
WILDFLY_IO_TASK_MAX_THREADS=1200
# NB: Postgres max_connections (default 100) must exceed WILDFLY_PACSDS_MAX_POOL_SIZE, otherwise
# the JDBC pool can never grow to its configured size and retrieves fail under load. It is not an
# env var of the postgres image - it is set on the dcm4chee-database command in docker-compose.yml.