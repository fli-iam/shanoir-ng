HTTP_PORT=8081
STORAGE_DIR=s3://test
# Optional first-start LDAP override for storage entry.
# Target entry (default points to the stock fs1 storage entry).
LDAP_STORAGE_ENTRY_DN=dcmStorageID=fs1,dicomDeviceName=dcm4chee-arc,cn=Devices,cn=DICOM Configuration,dc=dcm4che,dc=org
# If set, this URI replaces dcmURI in LDAP_STORAGE_ENTRY_DN at first LDAP initialization.
# Examples: /storage/custom-fs or s3://my-bucket/path
LDAP_STORAGE_URI=s3://test
POSTGRES_DB=pacsdb
POSTGRES_USER=pacs
POSTGRES_PASSWORD=pacs