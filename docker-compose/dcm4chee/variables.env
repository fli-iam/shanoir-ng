HTTP_PORT=8081
STORAGE_DIR=/storage/fs1

# Optional first-start LDAP override for storage entry.
# Target entry (default points to the stock fs1 storage entry).
LDAP_STORAGE_ENTRY_DN=dcmStorageID=fs1,dicomDeviceName=dcm4chee-arc,cn=Devices,cn=DICOM Configuration,dc=dcm4che,dc=org

# Filesystem storage is the default. To enable S3 on first LDAP init, set both:
#   STORAGE_DIR=s3://my-bucket
#   LDAP_STORAGE_URI=s3://my-bucket
# If unset/empty, ldap-first-start.sh keeps the stock filesystem configuration.
LDAP_STORAGE_URI=

# Optional first-start dcmProperty additions (one-shot).
# Target DN for dcmProperty updates (defaults to LDAP_STORAGE_ENTRY_DN).
LDAP_PROPERTY_TARGET_DN=

# One variable per property (env_file friendly).
# You can set as many as needed: LDAP_DCM_PROPERTY_1..LDAP_DCM_PROPERTY_N.
# S3 examples (uncomment when LDAP_STORAGE_URI points to S3):
# LDAP_DCM_PROPERTY_1=pathFormat={now,date,yyyy/MM/dd}/{0020000D,hash}/{0020000E,hash}/{00080018,hash}2
# LDAP_DCM_PROPERTY_2=checkMountFile=NO_MOUNT1
POSTGRES_DB=pacsdb
POSTGRES_USER=pacs
POSTGRES_PASSWORD=pacs

# PACS Database connection pool size
WILDFLY_PACSDS_MAX_POOL_SIZE=400

# IO_THREADS pool size (2~ more than cores is enough, more is useless)
WILDFLY_IO_THREADS=32

# TASK_THREAD pool size
WILDFLY_IO_TASK_MAX_THREADS=1200

# Must stay ABOVE the SHANOIR pool's max-idle-seconds (SHANOIR_PACS_MAX_IDLE_SECONDS, 15s by default)
WILDFLY_NO_REQUEST_TIMEOUT=120000

# ===== Shanoir datasets -> PACS HTTP client (read by the datasets container) =====

# Max parallel HTTP connections to the PACS. Must stay <= WILDFLY_IO_TASK_MAX_THREADS
SHANOIR_PACS_MAX_CONNECTIONS=1000

# Callers allowed to wait for a free connection, and how long they wait (s)
SHANOIR_PACS_PENDING_ACQUIRE_MAX_COUNT=10000
SHANOIR_PACS_PENDING_ACQUIRE_TIMEOUT_SECONDS=10

# Time to open a TCP connection to the PACS (ms)
SHANOIR_PACS_CONNECT_TIMEOUT_MS=5000

# Max silence from the PACS during a retrieve (s). Keep below the client's own timeout (VIP: 30s)
SHANOIR_PACS_RESPONSE_TIMEOUT_SECONDS=60

# Idle connection kept in the pool (s). Must stay BELOW WILDFLY_NO_REQUEST_TIMEOUT (in s)
SHANOIR_PACS_MAX_IDLE_SECONDS=15

# Max total lifetime of a pooled connection (s)
SHANOIR_PACS_MAX_LIFE_SECONDS=300

# Max size of a response buffered in memory (multipart / anonymised files), in bytes
SHANOIR_PACS_MAX_IN_MEMORY_BYTES=67108864
