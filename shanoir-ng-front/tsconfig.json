{
    "compileOnSave": false,
    "compilerOptions": {
        "noImplicitAny": false,
        "strict": false,
        "outDir": "./dist/out-tsc",
        "paths": {
            "@env/*": ["./src/environments/*"],
            "@app/*": ["./src/app/*"],
            "file-saver-es": ["./node_modules/@types/file-saver"],
            "wicg-file-system-access": ["./node_modules/@types/wicg-file-system-access"]
        },
        "esModuleInterop": true,
        "sourceMap": true,
        "declaration": false,
        "experimentalDecorators": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "importHelpers": true,
        "target": "ES2022",
        "lib": [
            "ES2024",
            "DOM"
        ],
        "typeRoots": [
          "node_modules/@types"
        ],
        "useDefineForClassFields": false
    },
    "angularCompilerOptions": {
        "fullTemplateTypeCheck": true,
        "strictInjectionParameters": true
    }
}
