# Config of nb-proxy.sh, the shared HTTPS proxy of the public nodes. Copy it next to the script as nb-proxy.conf
#   cp nb-proxy.conf.example nb-proxy.conf

# email of the Let's Encrypt account: expiry warnings if renewals fail (recommended)
LETSENCRYPT_EMAIL=developers_shanoir@inria.fr

# required: image versions of nginx-proxy and acme-companion (releases, never latest: it is a development build)
NGINX_PROXY_TAG=1.11.6
ACME_COMPANION_TAG=2.8.2
